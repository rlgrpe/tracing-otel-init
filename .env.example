# OpenTelemetry Configuration
# Copy this file to .env and customize for your environment

# OTLP endpoint URL (required for OTLP export)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service identification (required)
OTEL_SERVICE_NAME=my-service
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_INSTANCE_ID=instance-001

# Environment name
OTEL_ENVIRONMENT=dev
# Alternative: DEPLOYMENT_ENVIRONMENT=dev

# Default log level for all layers (trace, debug, info, warn, error, off)
OTEL_LOG_LEVEL=info

# Trace sampling ratio (0.0 to 1.0)
# 1.0 = sample all traces
# 0.1 = sample 10% of traces
OTEL_TRACES_SAMPLER_ARG=1.0
